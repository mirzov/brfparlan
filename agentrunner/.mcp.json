{
  "mcpServers": {
    "proton-imap-readonly": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "imap-mcp-server"
      ],
      "env": {
        "IMAP_MCP_READ_ONLY": "true",
        "NODE_EXTRA_CA_CERTS": "/home/oleg/workspace/parlan/brfparlan/emailassist/proton-bridge-cert.pem"
      }
    },
    "brf-mail-mcp": {
      "type": "stdio",
      "command": "env",
      "args": [
        "--chdir=/home/oleg/workspace/parlan/brfparlan/emailassist",
        "scala-cli", "run", ".",
        "--main-class", "se.brfparlan.emailassist.mcp.BrfMailMcp"
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-25-openjdk-amd64"
      }
    },
    "google-drive": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@piotr-agier/google-drive-mcp"]
    }
  }
}
